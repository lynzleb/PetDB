<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.petdb.env</string>

    <!-- __HOME__ is replaced with the current user's home dir by install.sh -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>__HOME__/.config/petdb/load-env.sh</string>
    </array>

    <!-- Run once at login/load, not kept alive as a daemon. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/petdb-env.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/petdb-env.err.log</string>
</dict>
</plist>
